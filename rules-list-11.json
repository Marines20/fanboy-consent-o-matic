  "EasyList Cookie Block - explicit domain cosmosdirekt.de": {
    "detectors": [
      {
        "presentMatcher": [
          {
            "type": "url",
            "url": "^https?://(?:www\\.)?cosmosdirekt\\.de(?:/|$)",
            "regexp": true
          }
        ]
      }
    ],
    "methods": [
      {
        "name": "DO_CONSENT",
        "action": {
          "type": "consent",
          "consents": [
            {
              "type": "F",
              "falseAction": {
                "type": "click",
                "target": {
                  "selector": "button, [role=\"button\"], input[type=\"button\"], input[type=\"submit\"], a",
                  "textFilter": [
                    "Reject all",
                    "Reject All",
                    "Reject",
