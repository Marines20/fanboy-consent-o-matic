{
  "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
  "Borlabs Cookie - emondo.de": {
    "detectors": [
      {
        "presentMatcher": [
          {
            "type": "url",
            "url": "^https?://(?:www\\.)?emondo\\.de(?:/|$)",
            "regexp": true
          }
        ],
        "showingMatcher": {
          "type": "css",
          "target": {
            "selector": "#BorlabsCookieBox"
          }
        }
      }
    ],
    "methods": [
      {
        "name": "DO_CONSENT",
        "action": {
          "type": "consent",
          "consents": [
            {
              "type": "F",
              "falseAction": {
                "type": "click",
                "target": {
                  "selector": "#BorlabsCookieBox ._brlbs-refuse-btn a"
                }
              }
            }
          ]
        }
      },
      {
        "name": "SAVE_CONSENT",
        "action": {
          "type": "click",
          "target": {
            "selector": "#CookieBoxSaveButton"
          }
        }
      },
      {
        "name": "HIDE_CMP",
        "action": {
          "type": "hide",
          "target": {
            "selector": "#BorlabsCookieBox"
          }
        }
      }
    ]
  },
