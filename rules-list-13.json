{
  "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
  "Allegro RODO consent": {
    "detectors": [
      {
        "presentMatcher": {
          "type": "url",
          "url": [
            "^https?://(?:www\\.)?allegro\\.pl(?:/|$)"
          ],
          "regexp": true
        },
        "showingMatcher": {
          "type": "css",
          "target": {
            "selector": "#opbox-rodo-consent-modal"
          }
        }
      }
    ],
    "methods": [
      {
        "name": "DO_CONSENT",
        "action": {
          "type": "consent",
          "consents": [
            {
              "type": "F",
              "falseAction": {
                "type": "click",
                "parent": {
                  "selector": "#opbox-rodo-consent-modal"
                },
                "target": {
                  "selector": "button, [role='button'], input[type='button'], input[type='submit']",
                  "textFilter": [
                    "Odrzuć",
                    "Odmów",
                    "Reject",
                    "Decline",
                    "Deny",
                    "Refuse",
                    "Disallow",
                    "No, thanks"
                  ]
                }
              }
            }
          ]
        }
      },
      {
        "name": "SAVE_CONSENT",
        "action": {
          "type": "click",
          "parent": {
            "selector": "#opbox-rodo-consent-modal"
          },
          "target": {
            "selector": "button, [role='button'], input[type='button'], input[type='submit']",
            "textFilter": [
              "Zapisz",
              "Potwierdź",
              "Zatwierdź",
              "Save",
              "Confirm",
              "Apply",
              "Done"
            ]
          }
        }
      }
    ]
  },
