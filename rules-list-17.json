{
  "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
  "Cookiebot – Settings": {
    "detectors": [
      {
        "presentMatcher": {
          "type": "css",
          "target": {
            "selector": "#CybotCookiebotDialog"
          }
        },
        "showingMatcher": {
          "type": "css",
          "target": {
            "selector": "#CybotCookiebotDialog"
          }
        }
      }
    ],
    "methods": [
      {
        "name": "OPEN_OPTIONS",
        "action": {
          "type": "click",
          "target": {
            "selector": "#CybotCookiebotDialogBodyLevelButtonCustomize, #CybotCookiebotDialogBodyLevelButtonLevelOptinAllowAll",
            "textFilter": [
              "Customize",
              "Customize settings",
              "Manage cookies",
              "Cookie settings"
            ]
          }
        }
      },
      {
        "name": "DO_CONSENT",
        "action": {
          "type": "click",
          "target": {
            "selector": "#CybotCookiebotDialogBodyButtonDecline, #CybotCookiebotDialogBodyLevelButtonLevelOptinDeclineAll"
          }
        }
      }
    ]
  },
  "OneTrust – Settings": {
    "detectors": [
      {
        "presentMatcher": {
          "type": "css",
          "target": {
            "selector": "#onetrust-consent-sdk"
          }
        },
        "showingMatcher": {
          "type": "css",
          "target": {
            "selector": "#onetrust-consent-sdk"
          }
        }
      }
    ],
    "methods": [
      {
        "name": "OPEN_OPTIONS",
        "action": {
          "type": "click",
          "target": {
            "selector": "#onetrust-pc-btn-handler"
          }
        }
      },
      {
        "name": "DO_CONSENT",
        "action": {
          "type": "click",
          "target": {
            "selector": "#onetrust-pc-sdk .ot-pc-refuse-all-handler, #onetrust-pc-sdk #onetrust-reject-all-handler"
          }
        }
      }
    ]
  },
  "Usercentrics – Settings": {
    "detectors": [
      {
        "presentMatcher": {
          "type": "css",
          "target": {
            "selector": "#usercentrics-root"
          }
        },
        "showingMatcher": {
          "type": "css",
          "target": {
            "selector": "#usercentrics-root"
          }
        }
      }
    ],
    "methods": [
      {
        "name": "OPEN_OPTIONS",
        "action": {
          "type": "click",
          "target": {
            "selector": "button, [role='button'], a",
            "textFilter": [
              "Settings",
              "Manage settings",
              "More information",
              "Privacy settings"
            ]
          }
        }
      },
      {
        "name": "DO_CONSENT",
        "action": {
          "type": "click",
          "target": {
            "selector": "uc-deny-all-button, [data-testid='uc-deny-all-button'], button, [role='button']",
            "textFilter": [
              "Deny all",
              "Reject all",
              "Decline all",
              "Do not accept",
              "Odrzuć wszystko",
              "Odmów wszystkim"
            ]
          }
        }
      }
    ]
  },
  "Sourcepoint – Settings": {
    "detectors": [
      {
        "presentMatcher": {
          "type": "css",
          "target": {
            "selector": "[id^='sp_message_container'], .message-container"
          }
        },
        "showingMatcher": {
          "type": "css",
          "target": {
            "selector": "[id^='sp_message_container'], .message-container"
          }
        }
      }
    ],
    "methods": [
      {
        "name": "OPEN_OPTIONS",
        "action": {
          "type": "click",
          "target": {
            "selector": ".sp_choice_type_12[title='Options'], [title='Options']"
          }
        }
      },
      {
        "name": "DO_CONSENT",
        "action": {
          "type": "click",
          "target": {
            "selector": ".sp_choice_type_11, [title='REJECT ALL']"
          }
        }
      }
    ]
  },
  "TrustArc – Settings": {
    "detectors": [
      {
        "presentMatcher": {
          "type": "css",
          "target": {
            "selector": "#truste-consent-content, .truste-consent-content, #truste-consent-track"
          }
        },
        "showingMatcher": {
          "type": "css",
          "target": {
            "selector": "#truste-consent-content, .truste-consent-content, #truste-consent-track"
          }
        }
      }
    ],
    "methods": [
      {
        "name": "OPEN_OPTIONS",
        "action": {
          "type": "click",
          "target": {
            "selector": "#truste-show-consent"
          }
        }
      },
      {
        "name": "DO_CONSENT",
        "action": {
          "type": "click",
          "target": {
            "selector": "#truste-consent-required"
          }
        }
      }
    ]
  },
  "Quantcast – Settings": {
    "detectors": [
