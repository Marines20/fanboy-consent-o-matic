{
  "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
  "OneTrust – 20min.ch": {
    "detectors": [
      {
        "presentMatcher": [
          {
            "type": "css",
            "target": {
              "selector": "#onetrust-consent-sdk"
            }
          }
        ],
        "showingMatcher": [
          {
            "type": "css",
            "target": {
              "selector": "#onetrust-consent-sdk"
            }
          }
        ]
      }
    ],
    "methods": [
      {
        "name": "DO_CONSENT",
        "action": {
          "type": "consent",
          "consents": [
            {
              "type": "F",
              "trueAction": {
                "type": "click",
                "target": {
                  "selector": "#onetrust-consent-sdk button.ot-pc-refuse-all-handler"
                }
              },
              "falseAction": {
                "type": "click",
                "target": {
                  "selector": "#onetrust-consent-sdk button.ot-pc-refuse-all-handler"
                }
              }
            }
          ]
        }
      },
      {
        "name": "HIDE_CMP"
      }
    ]
  },
