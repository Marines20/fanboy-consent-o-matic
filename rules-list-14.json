{
  "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
  "Borlabs Cookie (international specific)": {
    "detectors": [
      {
        "presentMatcher": [
          {
            "type": "url",
            "url": [
              "emondo.de",
              "seduction-magazin.de",
              "bajs.zagreb.hr"
            ]
          },
          {
            "type": "css",
            "target": {
              "selector": "#BorlabsCookieBox"
            }
          }
        ],
        "showingMatcher": {
          "type": "css",
          "target": {
            "selector": "#BorlabsCookieBox"
          }
        }
      }
    ],
    "methods": [
      {
        "name": "DO_CONSENT",
        "action": {
          "type": "click",
          "target": {
            "selector": "._brlbs-refuse-btn a"
          }
        }
      },
      {
        "name": "SAVE_CONSENT",
        "action": {
          "type": "click",
          "target": {
            "selector": "#CookieBoxSaveButton"
          }
        }
      },
      {
        "name": "HIDE_CMP"
      }
    ]
  },
  "CCM19 (international specific)": {
    "detectors": [
      {
        "presentMatcher": [
          {
            "type": "url",
            "url": [
              "ccm19.atradior.de",
              "epccm19.com",
              "kefalonia-griechenland.com",
              "mindpark.at"
            ]
          },
          {
            "type": "css",
            "target": {
              "selector": ".ccm-root"
            }
          }
        ],
        "showingMatcher": {
          "type": "css",
          "target": {
            "selector": ".ccm-root"
          }
        }
      }
    ],
    "methods": [
      {
        "name": "DO_CONSENT",
        "action": {
          "type": "click",
          "target": {
            "selector": ".ccm-root button",
            "textFilter": [
              "Ablehnen",
              "Reject",
              "Decline",
              "Refuse"
            ]
          }
        }
      },
      {
        "name": "SAVE_CONSENT",
        "action": {
          "type": "click",
          "target": {
            "selector": ".ccm-root button",
            "textFilter": [
              "Speichern",
              "Save settings",
              "Save"
            ]
          }
        }
      },
      {
        "name": "HIDE_CMP"
      }
    ]
  },
  "tarteaucitron (RATP)": {
    "detectors": [
      {
        "presentMatcher": [
          {
            "type": "url",
            "url": [
              "ratp.fr"
            ]
          },
          {
            "type": "css",
            "target": {
              "selector": "#tarteaucitron"
            }
          }
        ],
        "showingMatcher": {
          "type": "css",
          "target": {
            "selector": "#tarteaucitron"
          }
        }
      }
    ],
    "methods": [
      {
        "name": "DO_CONSENT",
        "action": {
          "type": "click",
          "target": {
            "selector": "#tarteaucitronAllDenied"
          }
        }
      },
      {
        "name": "HIDE_CMP"
      }
    ]
  },
  "Cookie Law Info (international specific)": {
    "detectors": [
      {
        "presentMatcher": [
          {
            "type": "url",
            "url": [
              "krookmedia.fi",
              "pirkkalainen.fi",
              "ok-salute.it"
            ]
          },
          {
            "type": "css",
            "target": {
              "selector": "#cookie-law-info-bar"
            }
          }
        ],
        "showingMatcher": {
          "type": "css",
          "target": {
            "selector": "#cookie-law-info-bar"
          }
        }
      }
    ],
    "methods": [
      {
        "name": "DO_CONSENT",
        "action": {
          "type": "click",
          "target": {
            "selector": "#wt-cli-reject-btn, .wt-cli-reject-btn"
          }
        }
      },
      {
        "name": "SAVE_CONSENT",
        "action": {
          "type": "click",
          "target": {
            "selector": "#wt-cli-accept-btn, .wt-cli-accept-btn"
          }
        }
      },
      {
        "name": "HIDE_CMP"
      }
    ]
  },
  "Gravito CMP (international specific)": {
    "detectors": [
      {
        "presentMatcher": [
          {
            "type": "url",
            "url": [
              "veho.fi"
            ]
          },
          {
            "type": "css",
            "target": {
              "selector": ".gravitoCcpaCmp-card"
            }
          }
        ],
        "showingMatcher": {
