  "Cookie consent (Allegro specific)": {
    "detectors": [
      {
        "presentMatcher": [
          {
            "type": "url",
            "url": [
              "allegro.pl"
            ]
          },
          {
            "type": "css",
            "target": {
              "selector": "[class*=\"rodo-consent\"], [class*=\"consent-modal\"]"
            }
          }
        ],
        "showingMatcher": {
          "type": "css",
          "target": {
            "selector": "[class*=\"rodo-consent\"], [class*=\"consent-modal\"]"
          }
        }
      }
    ],
    "methods": [
      {
        "name": "DO_CONSENT",
        "action": {
          "type": "click",
          "target": {
            "selector": "button",
            "textFilter": [
              "Odrzuć",
              "Odmów",
              "Reject",
              "Decline",
              "Nie zgadzam się"
            ]
          }
        }
      },
      {
        "name": "SAVE_CONSENT",
        "action": {
          "type": "click",
          "target": {
            "selector": "button",
            "textFilter": [
              "Zapisz",
              "Save",
              "Potwierdź",
              "Confirm"
            ]
          }
        }
      },
      {
        "name": "HIDE_CMP"
      }
    ]
  }
