      },
      {
        "name": "SAVE_CONSENT",
        "action": {
          "type": "click",
          "target": {
            "selector": ".gravitoCcpaCmp-card button",
            "textFilter": [
              "Save",
              "Confirm",
              "Done"
            ]
          }
        }
      },
      {
        "name": "HIDE_CMP"
      }
    ]
  },
