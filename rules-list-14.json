  "OneTrust IAB / RodoGuard (Gazeta)": {
    "detectors": [
      {
        "presentMatcher": [
          {
            "type": "url",
            "url": [
              "gazeta.pl"
            ]
          },
          {
            "type": "css",
            "target": {
              "selector": "[id*=\"onetrust\"], [class*=\"onetrust\"]"
            }
          }
        ],
        "showingMatcher": {
          "type": "css",
          "target": {
            "selector": "[id*=\"onetrust\"], [class*=\"onetrust\"]"
          }
        }
